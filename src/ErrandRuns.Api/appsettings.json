{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=ErrandRuns;User Id=sa;Password=replace-in-environment;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ErrandRuns",
    "Audience": "ErrandRuns.Mobile",
    "AccessTokenMinutes": 60,
    "SigningKey": "replace-in-environment-with-at-least-32-random-bytes"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8081"
    ]
  },
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrations": false
  },
  "RunnerPayments": {
    "RunnerPercent": 80,
    "PayoutFee": 50
  },
  "GoogleMaps": {
    "Enabled": false,
    "ServerApiKey": "",
    "PlacesBaseUrl": "https://places.googleapis.com",
    "GeocodingBaseUrl": "https://geocode.googleapis.com",
    "LagosLatitude": 6.5244,
    "LagosLongitude": 3.3792,
    "LagosBiasRadiusMeters": 50000,
    "TimeoutSeconds": 10
  },
  "IpGeolocation": {
    "Enabled": false,
    "Provider": "IpApiCo",
    "BaseUrl": "https://ipapi.co",
    "TimeoutSeconds": 5
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "ExternalServices": {
    "Paystack": {
      "Enabled": false,
      "SecretKey": "",
      "PublicKey": "",
      "WebhookSecret": "",
      "BaseUrl": "https://api.paystack.co"
    },
    "SendGrid": {
      "Enabled": false,
      "ApiKey": "",
      "FromEmail": "",
      "FromName": "ErrandRuns",
      "BaseUrl": "https://api.sendgrid.com"
    },
    "Termii": {
      "Enabled": false,
      "ApiKey": "",
      "SenderId": "ErrandRuns",
      "BaseUrl": "https://api.ng.termii.com"
    },
    "SmileIdentity": {
      "Enabled": false,
      "PartnerId": "",
      "ApiKey": "",
      "WebhookSecret": "",
      "BaseUrl": "https://api.smileidentity.com"
    },
    "AzureBlobStorage": {
      "Enabled": false,
      "ConnectionString": "",
      "PrivateContainer": "errandruns-private",
      "SignedUrlLifetimeMinutes": 10
    },
    "Firebase": {
      "Enabled": false,
      "ProjectId": "",
      "ServiceAccountJsonBase64": ""
    },
    "OpenTelemetry": {
      "Enabled": false,
      "OtlpEndpoint": "",
      "OtlpHeaders": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  }
}
