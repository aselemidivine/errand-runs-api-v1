# Copy this file to .env for Docker Compose. Never commit .env.
# Generate secrets with a cryptographically secure password/secret generator.

# Core database and authentication
ERRANDRUNS_DB_PASSWORD=replace-with-a-strong-sql-password
ERRANDRUNS_JWT_KEY=replace-with-at-least-32-random-bytes

# Maps, geocoding, distance matrix, and route estimates
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=replace-with-google-maps-server-api-key

# Payments, Nigerian banks, transfers, USSD, and webhook verification
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key
PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret

# Transactional email
SENDGRID_ENABLED=false
SENDGRID_API_KEY=replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=ErrandRuns

# Nigerian SMS and OTP delivery
TERMII_ENABLED=false
TERMII_API_KEY=replace-with-termii-api-key
TERMII_SENDER_ID=ErrandRuns

# Runner identity/KYC verification
SMILE_IDENTITY_ENABLED=false
SMILE_IDENTITY_PARTNER_ID=replace-with-smile-partner-id
SMILE_IDENTITY_API_KEY=replace-with-smile-api-key
SMILE_IDENTITY_WEBHOOK_SECRET=replace-with-smile-webhook-secret

# Private KYC, prescription, receipt, proof-of-delivery, and profile files
AZURE_BLOB_ENABLED=false
AZURE_BLOB_CONNECTION_STRING=replace-with-azure-storage-connection-string
AZURE_BLOB_PRIVATE_CONTAINER=errandruns-private

# Mobile push notifications. Base64 avoids multiline JSON in environment variables.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-service-account-json

# Traces and metrics (Grafana Cloud, Azure Monitor collector, etc.)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=https://replace-with-otel-collector.example.com
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace-with-token
